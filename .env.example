# ==========================================================
#  MeetMind — Environment Variables (copy to .env.local)
# ==========================================================

# --- Next.js / App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Database ---
# MongoDB connection string (Atlas or self-hosted)
DATABASE_URL=mongodb://localhost:27017/meetmind
# MongoDB database name
MONGODB_DB=meetmind

# --- Redis (real-time events, sessions) ---
REDIS_URL=redis://localhost:6379

# --- Authentication (OAuth providers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# --- AI Services ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_TEST=

# --- AWS S3 (recordings & asset storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=meetmind-recordings
AWS_S3_REGION=us-east-1

# --- Media / Signaling ---
SIGNALING_SERVER_URL=http://localhost:4000

# --- Email (transactional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@meetmind.example
